{
  "name": "tailwind-nextjs-starter-blog",
  "version": "1.5.6",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  },
  "scripts": {
    "start": "cross-env SOCKET=true node ./scripts/next-remote-watch.js ./data",
    "dev": "tinacms dev -c \"next dev\"",
    "dev:local": "tinacms dev -c \"next dev\"",
    "build": "tinacms build && next build && node ./scripts/generate-sitemap",
    "build:local": "tinacms build --local --skip-cloud-checks && next build && node ./scripts/generate-sitemap",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "lint": "next lint --fix --dir pages --dir components --dir lib --dir layouts --dir scripts --dir tina",
    "prepare": "husky install"
  },
  "dependencies": {
    "@fontsource/crimson-pro": "5.2.8",
    "@fontsource/inter": "4.5.2",
    "@fontsource/lora": "5.2.8",
    "@fontsource/playfair-display": "5.2.8",
    "@heroicons/react": "2.2.0",
    "@mailchimp/mailchimp_marketing": "^3.0.80",
    "@next/bundle-analyzer": "^15.5.19",
    "@tailwindcss/forms": "^0.4.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tinacms/cli": "^2.5.1",
    "autoprefixer": "^10.5.1",
    "chart.js": "^3.9.1",
    "cloudinary": "2.7.0",
    "date-fns": "^4.4.0",
    "esbuild": "^0.25.12",
    "github-slugger": "^1.5.0",
    "gray-matter": "^4.0.3",
    "image-size": "1.0.0",
    "js-yaml": "^4.2.0",
    "katex": "0.16.22",
    "mdast-util-to-string": "4.0.0",
    "mdx-bundler": "^9.2.1",
    "next": "^15.5.19",
    "next-cloudinary": "6.16.0",
    "next-themes": "^0.3.0",
    "postcss": "^8.5.15",
    "posthog-js": "^1.393.4",
    "react": "^18.3.1",
    "react-chartjs-2": "^4.3.1",
    "react-dom": "^18.3.1",
    "react-flag-kit": "^1.1.1",
    "react-icons": "^4.12.0",
    "react-query": "^3.39.3",
    "react-snowfall": "^1.2.1",
    "reading-time": "1.3.0",
    "rehype-autolink-headings": "^6.1.1",
    "rehype-citation": "^0.4.0",
    "rehype-katex": "^6.0.3",
    "rehype-preset-minify": "6.0.0",
    "rehype-prism-plus": "^1.6.3",
    "rehype-slug": "^5.1.0",
    "remark-footnotes": "^4.0.1",
    "remark-gfm": "^3.0.1",
    "remark-math": "^5.1.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.19",
    "tinacms": "3.9.3",
    "unist-util-visit": "^4.1.2",
    "use-sound": "^4.0.4"
  },
  "devDependencies": {
    "@svgr/webpack": "^6.5.1",
    "axios": "^1.18.1",
    "cheerio": "^1.2.0",
    "cross-env": "^7.0.3",
    "dedent": "^0.7.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.19",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-prettier": "^3.4.1",
    "file-loader": "^6.2.0",
    "globby": "11.0.3",
    "husky": "^6.0.0",
    "inquirer": "^8.2.7",
    "lint-staged": "^11.2.6",
    "next-remote-watch": "^1.0.0",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.1.13",
    "reading-time": "^1.5.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  }
}
